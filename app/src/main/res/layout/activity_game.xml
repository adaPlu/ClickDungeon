<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <!-- Top bar for gold, MP, HP, and floor -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:weightSum="5">

        <TextView
            android:id="@+id/textGoldCounter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/gold_display"
            android:textStyle="bold"
            android:textSize="18sp"
            android:padding="4dp" />

        <TextView
            android:id="@+id/textPlatinumCounter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/platinum_display"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"
            android:padding="4dp" />

        <TextView
            android:id="@+id/textMpCounter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mp_display_dynamic"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"
            android:padding="4dp" />

        <TextView
            android:id="@+id/textHpCounter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/hp_display_placeholder"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"
            android:padding="4dp" />

        <TextView
            android:id="@+id/textFloor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/floor_display_placeholder"
            android:textSize="18sp"
            android:gravity="end"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Status effect indicator -->
    <TextView
        android:id="@+id/textStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textStyle="italic"
        android:textColor="#88000000"
        android:paddingTop="6dp" />

    <!-- Dungeon grid -->
    <GridLayout
        android:id="@+id/gridDungeon"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="5"
        android:rowCount="5"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true"
        android:paddingTop="8dp" />

    <!-- Class ability button -->
    <Button
        android:id="@+id/btnClassAbility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/use_ability"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnLevelUp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/level_up"
        android:layout_marginTop="6dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnInventory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/open_inventory"
        android:layout_marginTop="6dp" />
</LinearLayout>
