<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/textInventoryGold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="16sp"
        android:text="@string/gold_display" />

    <TextView
        android:id="@+id/textInventoryPlatinum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="16sp"
        android:text="@string/platinum_display"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/textInventoryMp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="16sp"
        android:text="@string/mp_display_dynamic"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/textInventoryCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="15sp"
        android:layout_marginTop="6dp"
        android:text="@string/inventory_item_count" />

    <TextView
        android:id="@+id/textEquippedWeapon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="15sp"
        android:layout_marginTop="10dp"
        android:text="@string/equipped_weapon_label" />

    <TextView
        android:id="@+id/textEquippedArmor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="15sp"
        android:layout_marginTop="4dp"
        android:text="@string/equipped_armor_label" />

    <TextView
        android:id="@+id/textStatDelta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:layout_marginTop="6dp"
        android:text="@string/equipped_stat_delta" />

    <LinearLayout
        android:id="@+id/layoutStatAllocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/textStatAllocationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="15sp"
            android:text="@string/stat_allocate_title" />

        <TextView
            android:id="@+id/textStatPoints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginTop="2dp"
            android:text="@string/stat_points_available" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/textStatStrength"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/stat_label_strength" />

            <Button
                android:id="@+id/buttonStatStrength"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="@string/stat_add_button" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/textStatDexterity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/stat_label_dexterity" />

            <Button
                android:id="@+id/buttonStatDexterity"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="@string/stat_add_button" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/textStatConstitution"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/stat_label_constitution" />

            <Button
                android:id="@+id/buttonStatConstitution"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="@string/stat_add_button" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/textStatIntelligence"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/stat_label_intelligence" />

            <Button
                android:id="@+id/buttonStatIntelligence"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="@string/stat_add_button" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerInventory"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/textEmptyInventory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/inventory_empty"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textInventoryChangeLogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textStyle="bold"
        android:textSize="15sp"
        android:text="@string/inventory_recent_changes" />

    <TextView
        android:id="@+id/textInventoryChangeLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/inventory_no_changes"
        android:textSize="14sp" />
</LinearLayout>
