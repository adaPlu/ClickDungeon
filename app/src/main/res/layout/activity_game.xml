<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutGameRoot"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_screen_dungeon">

    <!-- Top bar for currency and floor -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:weightSum="3">

        <TextView
            android:id="@+id/textGoldCounter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/gold_display"
            android:textStyle="bold"
            android:textSize="18sp"
            android:padding="4dp" />

        <TextView
            android:id="@+id/textPlatinumCounter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/platinum_display"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"
            android:padding="4dp" />

        <TextView
            android:id="@+id/textFloor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/floor_display_placeholder"
            android:textSize="18sp"
            android:gravity="end"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Status effect indicator -->
    <TextView
        android:id="@+id/textStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textStyle="italic"
        android:textColor="@color/status_effect_text"
        android:paddingTop="6dp" />

    <!-- Dungeon grid -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridLayout
            android:id="@+id/gridDungeon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:columnCount="5"
            android:rowCount="5"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="true"
            android:paddingTop="8dp" />
    </FrameLayout>

    <!-- Bottom HUD: name, class XP, and quick actions -->
    <LinearLayout
        android:id="@+id/layoutPlayerHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/textPlayerNameLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:text="@string/player_hud_name_class_placeholder"
                android:textStyle="bold"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/layoutXpMpStack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/textXpCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xp_display_placeholder"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imagePlayerHudIcon"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:contentDescription="@string/player_hud_icon_desc"
                android:src="@drawable/icon_knight"
                android:scaleType="centerInside"
                android:layout_gravity="center_vertical" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <ProgressBar
                    android:id="@+id/progressHpCounter"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="#FF4CAF50"
                    android:background="#33000000"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/textHpCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/hp_display_placeholder"
                    android:textStyle="bold"
                    android:textSize="14sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical"
                android:gravity="end">

                <Button
                    android:id="@+id/btnClassAbility"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/use_ability"
                    android:contentDescription="@string/use_ability_desc"
                    android:textSize="11sp"
                    android:background="@drawable/menu_button_bg"
                    android:textColor="#FFF3D5" />

                <Button
                    android:id="@+id/btnClassMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:minHeight="48dp"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/open_class_menu"
                    android:contentDescription="@string/open_class_menu_desc"
                    android:textSize="11sp"
                    android:background="@drawable/menu_button_bg"
                    android:textColor="#FFF3D5" />

                <Button
                    android:id="@+id/btnInventory"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:minHeight="48dp"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/open_inventory"
                    android:contentDescription="@string/open_inventory_desc"
                    android:textSize="11sp"
                    android:background="@drawable/menu_button_bg"
                    android:textColor="#FFF3D5" />

                <Button
                    android:id="@+id/btnUsePotion"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:minHeight="48dp"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/use_potion"
                    android:contentDescription="@string/use_potion_desc"
                    android:textSize="11sp"
                    android:background="@drawable/menu_button_bg"
                    android:textColor="#FFF3D5" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
