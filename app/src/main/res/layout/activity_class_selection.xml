<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <EditText
        android:id="@+id/editCharacterName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Character Name"
        android:inputType="textPersonName"
        android:padding="12dp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnKnight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Knight (HP: 10)"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnThief"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thief (HP: 6)"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnWizard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wizard (HP: 4)"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnBackToMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back to Menu" />

</LinearLayout>
