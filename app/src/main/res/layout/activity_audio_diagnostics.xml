<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_screen_dungeon">

    <TextView
        android:id="@+id/textAudioDiagnosticsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/audio_diagnostics_title"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
        android:textColor="#F6E6C6"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/textAudioDiagnosticsBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/audio_diagnostics_empty"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
        android:textColor="#D6C2A5" />
</LinearLayout>
