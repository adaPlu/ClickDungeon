<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_dungeon">

    <EditText
        android:id="@+id/editName"
        android:hint="Enter character name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/panel_bg"
        android:textColor="#F6E6C6"
        android:textColorHint="#C9B28A"
        android:inputType="textPersonName"
        android:maxLines="1"
        android:layout_marginBottom="16dp" />

    <ImageView
        android:id="@+id/imageClassPreview"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/icon_knight"
        android:layout_marginBottom="16dp"
        android:contentDescription="Class Preview" />

	<TextView
        android:id="@+id/textSlotDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Slot: 1"
        android:textSize="16sp"
        android:textColor="#D6C2A5"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose your class:"
        android:textSize="18sp"
        android:textColor="#F6E6C6"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center">

        <Button
            android:id="@+id/btnKnight"
            android:text="Knight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_button_bg"
            android:textColor="#FFF3D5"
            android:drawableStart="@drawable/icon_knight"
            android:drawablePadding="8dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnThief"
            android:text="Thief"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_button_bg"
            android:textColor="#FFF3D5"
            android:drawableStart="@drawable/icon_thief"
            android:drawablePadding="8dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnWizard"
            android:text="Wizard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_button_bg"
            android:textColor="#FFF3D5"
            android:drawableStart="@drawable/icon_wizard"
            android:drawablePadding="8dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnStart"
        android:text="Start Adventure"
        android:layout_marginTop="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/menu_button_bg"
        android:textColor="#FFF3D5" />
</LinearLayout>
