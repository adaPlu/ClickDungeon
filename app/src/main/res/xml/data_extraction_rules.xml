<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Customize <include> and <exclude> entries here to control
             which app data is backed up to cloud/device transfer. Examples:
             <include domain="sharedpref" path="your_prefs.xml"/>
             <exclude domain="sharedpref" path="sensitive_prefs.xml"/>
        -->
    </cloud-backup>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
</data-extraction-rules>