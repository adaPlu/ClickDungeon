<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout 
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Slot 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:id="@+id/slot1Info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Slot 1 Info"
                android:textSize="16sp" />

            <Button
                android:id="@+id/slot1Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Slot 1 Action" />
        </LinearLayout>

        <!-- Slot 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:id="@+id/slot2Info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Slot 2 Info"
                android:textSize="16sp" />

            <Button
                android:id="@+id/slot2Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Slot 2 Action" />
        </LinearLayout>

        <!-- Slot 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:id="@+id/slot3Info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Slot 3 Info"
                android:textSize="16sp" />

            <Button
                android:id="@+id/slot3Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Slot 3 Action" />
        </LinearLayout>

        <!-- Slot 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:id="@+id/slot4Info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Slot 4 Info"
                android:textSize="16sp" />

            <Button
                android:id="@+id/slot4Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Slot 4 Action" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
