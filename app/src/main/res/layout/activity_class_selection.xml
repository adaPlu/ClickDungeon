<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_dungeon">

    <EditText
        android:id="@+id/editName"
        android:hint="@string/enter_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/panel_bg"
        android:textColor="#F6E6C6"
        android:textColorHint="#C9B28A"
        android:inputType="textPersonName"
        android:autofillHints="name"
        android:maxLines="1"
        android:layout_marginBottom="16dp" />

    <ImageView
        android:id="@+id/imageClassPreview"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/icon_knight"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/class_preview_content_desc" />

	<TextView
        android:id="@+id/textSlotDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/slot_display_placeholder"
        android:textSize="16sp"
        android:textColor="#D6C2A5"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/choose_class_label"
        android:textSize="18sp"
        android:textColor="#F6E6C6"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        style="?android:attr/buttonBarStyle">

        <Button
            android:id="@+id/btnKnight"
            style="?android:attr/buttonBarButtonStyle"
            android:text="@string/knight_option"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_button_bg"
            android:textColor="#FFF3D5"
            android:drawableStart="@drawable/icon_knight"
            android:drawablePadding="8dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnThief"
            style="?android:attr/buttonBarButtonStyle"
            android:text="@string/thief_option"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_button_bg"
            android:textColor="#FFF3D5"
            android:drawableStart="@drawable/icon_thief"
            android:drawablePadding="8dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnWizard"
            style="?android:attr/buttonBarButtonStyle"
            android:text="@string/wizard_option"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_button_bg"
            android:textColor="#FFF3D5"
            android:drawableStart="@drawable/icon_wizard"
            android:drawablePadding="8dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnShop"
        android:text="@string/shop"
        android:layout_marginTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/menu_button_bg"
        android:textColor="#FFF3D5" />

    <Button
        android:id="@+id/btnStart"
        android:text="@string/start_game"
        android:layout_marginTop="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/menu_button_bg"
        android:textColor="#FFF3D5" />
</LinearLayout>
