<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:fillViewport="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_screen_dungeon">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxWidth="500dp"
        android:layout_gravity="center_horizontal">

        <EditText
            android:id="@+id/editName"
            android:hint="@string/enter_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/panel_bg"
            android:textColor="#F6E6C6"
            android:textColorHint="#C9B28A"
            android:inputType="textPersonName"
            android:autofillHints="name"
            android:maxLines="1"
            android:padding="12dp"
            android:layout_marginBottom="32dp"
            android:contentDescription="@string/character_name_field_desc" />

    <ImageView
        android:id="@+id/imageClassPreview"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/icon_knight"
        android:layout_marginBottom="24dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/class_preview_content_desc" />

	<TextView
        android:id="@+id/textSlotDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/slot_display_placeholder"
        android:textSize="14sp"
        android:textColor="#D6C2A5"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/choose_class_label"
        android:textSize="16sp"
        android:textColor="#F6E6C6"
        android:layout_marginBottom="16dp" />

    <TableLayout
        android:id="@+id/classOptionsGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="*"
        android:shrinkColumns="*"
        android:layout_marginBottom="24dp">

        <TableRow>
            <Button
                android:id="@+id/btnKnight"
                style="?android:attr/buttonBarButtonStyle"
                android:text="@string/knight_option"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/menu_button_bg"
                android:textColor="#FFF3D5"
                android:textSize="13sp"
                android:drawableStart="@drawable/icon_knight"
                android:drawablePadding="6dp" />

            <Button
                android:id="@+id/btnRanger"
                style="?android:attr/buttonBarButtonStyle"
                android:text="@string/ranger_option"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/menu_button_bg"
                android:textColor="#FFF3D5"
                android:textSize="13sp"
                android:drawableStart="@drawable/icon_thief"
                android:drawablePadding="6dp"
                android:visibility="gone" />
        </TableRow>

        <TableRow>
            <Button
                android:id="@+id/btnThief"
                style="?android:attr/buttonBarButtonStyle"
                android:text="@string/thief_option"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/menu_button_bg"
                android:textColor="#FFF3D5"
                android:textSize="13sp"
                android:drawableStart="@drawable/icon_thief"
                android:drawablePadding="6dp" />

            <Button
                android:id="@+id/btnWizard"
                style="?android:attr/buttonBarButtonStyle"
                android:text="@string/wizard_option"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/menu_button_bg"
                android:textColor="#FFF3D5"
                android:textSize="13sp"
                android:drawableStart="@drawable/icon_wizard"
                android:drawablePadding="6dp" />
        </TableRow>
    </TableLayout>

    <Button
        android:id="@+id/btnShop"
        android:text="@string/shop"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/menu_button_bg"
        android:textColor="#FFF3D5"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnStart"
        android:text="@string/start_game"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/menu_button_bg"
        android:textColor="#FFF3D5"
        android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
