<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/dungeon_door_open">

    <LinearLayout 
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:maxWidth="550dp"
        android:layout_gravity="center_horizontal">

        <!-- Slot 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/panel_bg">

            <TextView
                android:id="@+id/slot1Info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/continue_slot_info_placeholder"
                android:textSize="14sp"
                android:textColor="#F6E6C6"
                android:ellipsize="end"
                android:maxLines="2" />

            <Button
                android:id="@+id/slot1Button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="10dp"
                android:text="@string/continue_slot_action_placeholder"
                android:background="@drawable/menu_button_bg"
                android:textColor="#FFF3D5"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Slot 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/panel_bg">

            <TextView
                android:id="@+id/slot2Info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/continue_slot_info_placeholder"
                android:textSize="14sp"
                android:textColor="#F6E6C6"
                android:ellipsize="end"
                android:maxLines="2" />

            <Button
                android:id="@+id/slot2Button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="10dp"
                android:text="@string/continue_slot_action_placeholder"
                android:background="@drawable/menu_button_bg"
                android:textColor="#FFF3D5"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Slot 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/panel_bg">

            <TextView
                android:id="@+id/slot3Info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/continue_slot_info_placeholder"
                android:textSize="14sp"
                android:textColor="#F6E6C6"
                android:ellipsize="end"
                android:maxLines="2" />

            <Button
                android:id="@+id/slot3Button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="10dp"
                android:text="@string/continue_slot_action_placeholder"
                android:background="@drawable/menu_button_bg"
                android:textColor="#FFF3D5"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Slot 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/panel_bg">

            <TextView
                android:id="@+id/slot4Info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/continue_slot_info_placeholder"
                android:textSize="14sp"
                android:textColor="#F6E6C6"
                android:ellipsize="end"
                android:maxLines="2" />

            <Button
                android:id="@+id/slot4Button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="10dp"
                android:text="@string/continue_slot_action_placeholder"
                android:background="@drawable/menu_button_bg"
                android:textColor="#FFF3D5"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
